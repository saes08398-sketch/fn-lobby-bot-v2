# Fortnite Lobby Bot Environment Variables
# Copy this file to .env and fill in your values, or set them in Railway.

# Epic Games client credentials for Fortnite.
# These change with Fortnite updates. You must supply a working client_id/client_secret
# (commonly extracted from the Fortnite game client or known community sources).
# Leave these empty to be prompted, or set them in Railway.
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=

# Web server port (Railway sets PORT automatically)
PORT=3000

# Optional: bot display name (used in status page)
BOT_NAME=FN Lobby Bot

# Optional: default skin/emote IDs (leave empty to use random/featured)
DEFAULT_SKIN=
DEFAULT_EMOTE=

# Optional: enable party invite auto-accept
AUTO_ACCEPT_INVITES=true

# Optional: email/password auto-login (for Railway or headless use)
EPIC_EMAIL=
EPIC_PASSWORD=
